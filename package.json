{
  "name": "desert-sdk",
  "version": "0.0.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./products/landmarks/reference.ts": "./products/landmarks/reference.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "authoring:generate": "node scripts/authoring-references.ts --write",
    "authoring:check": "node scripts/authoring-references.ts --check",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 tests/*.test.ts",
    "test:journeys": "node --test --test-timeout=30000 tests/notebook-journeys.test.ts",
    "verify:notebook": "node scripts/verify-notebook.ts",
    "verify:derived": "node products/notebook/verify.ts",
    "test:recovery": "node --test --test-timeout=30000 tests/database-handoff.test.ts tests/local-availability*.test.ts tests/local-recovery.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "inspect": "node products/notebook/inspect.ts",
    "notebook:local": "node products/notebook/run-local.ts",
    "web:build": "node products/notebook/build-web.ts",
    "web:check": "node products/notebook/check-web.ts",
    "notebook:web": "node products/notebook/run-web.ts",
    "test:web": "node --test --test-concurrency=2 tests/web/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "music-metadata": "12.2.3",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.57.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "bits-ui": "2.19.2",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tabbable": "6.5.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
