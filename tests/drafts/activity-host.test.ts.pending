// Saved unimplemented façade acceptance draft; intentionally excluded from test/typecheck discovery.
import assert from "node:assert/strict";
import { after, before, test } from "node:test";
import { compile } from "../src/compile.ts";
import { openLocalController, type LocalSession } from "../src/local.ts";
import { localActivity } from "../src/local/activity.ts";
import { ActivityVersion, activityRequest, activitySnapshot, type ActivitySnapshot, type ActivityAction,
  type ActivityContent } from "../src/activity/schema.ts";
import { MultiNotebook, multiProgram } from "./fixtures/multi-view-program.ts";
import { postgresCluster } from "./fixtures/postgres.ts";
import { until } from "./fixtures/multi-view-runtime.ts";

const application = compile({ ...MultiNotebook, surfaces: MultiNotebook.surfaces.map(surface => surface.kind !== "human"
  ? surface : { ...surface, commit: { ...surface.commit, "create-note": "review", "edit-note": "review" } }) });
const expected = { id: "human", contractDigest: application.digest };
let cluster: ReturnType<typeof postgresCluster>;
before(() => { cluster = postgresCluster(); });
after(() => { cluster?.dispose(); });
const roundtrip = <T>(value: T): T => JSON.parse(JSON.stringify(value));
function items(content: readonly ActivityContent[]): ActivityContent[] {
  return content.flatMap(item => item.kind === "stack" ? [item, ...items(item.items)] : [item]);
}
function request(snapshot: ActivitySnapshot, owner: string, action: ActivityAction, value?: string) {
  return roundtrip({ version: ActivityVersion, revision: snapshot.revision, owner, action: action.handle,
    ...(value === undefined ? {} : { value }) });
}
function action(snapshot: ActivitySnapshot, label: string) {
  const surface = snapshot.panel ?? snapshot.main;
  const action = surface.actions.find(item => item.label === label);
  assert.ok(action, `Missing action ${label}`);
  return request(snapshot, surface.owner, action);
}
function field(snapshot: ActivitySnapshot, name: string, value: string) {
  const surface = snapshot.panel ?? snapshot.main;
  const form = items(surface.content).find(item => item.kind === "form");
  assert.ok(form?.kind === "form");
  const field = form.fields.find(item => item.name === name);
  assert.ok(field);
  return request(snapshot, surface.owner, field.action, value);
}

test("closed serializable activity drives authentic Home → Notes → review → detail → edit without exposing internal state", async t => {
  const host = await openLocalController(application, { ...await cluster.database(), role: "notes" });
  t.after(() => host.close());
  const identity = await host.identities.issue("Serializable activity"), session = host.connect(identity.token, "human");
  const activity = localActivity(session, multiProgram, expected);
  t.after(() => activity.stop());
  const observed: ActivitySnapshot[] = [];
  const unsubscribe = activity.subscribe(value => { observed.push(activitySnapshot(roundtrip(value))); });
  t.after(unsubscribe);
  await activity.start();
  await until(() => activity.snapshot().main.actions.find(item => item.label === "Notes")?.state === "ready");
  activity.dispatch(action(activity.snapshot(), "Notes"));
  await until(() => activity.snapshot().main.actions.find(item => item.label === "New note")?.state === "ready");
  activity.dispatch(action(activity.snapshot(), "New note"));
  activity.dispatch(field(activity.snapshot(), "title", "Serializable note"));
  activity.dispatch(field(activity.snapshot(), "body", "Declared editable body"));
  const draft = activity.snapshot();
  const form = items(draft.panel!.content).find(item => item.kind === "form");
  assert.ok(form?.kind === "form");
  assert.deepEqual(form.fields.map(item => item.name), ["title", "body"]);
  assert.equal(form.fields.find(item => item.name === "body")?.value, "Declared editable body");
  activity.dispatch(action(draft, "Create note"));
  await until(() => activity.snapshot().phase === "review" && !activity.snapshot().busy);
  assert.deepEqual(await session.read((await session.begin("read-note")).id), []);
  const review = activity.snapshot();
  assert.equal(JSON.stringify(review).includes("confirmationDigest"), false);
  activity.dispatch(action(review, "Create note"));
  await until(() => activity.snapshot().panel?.title === "Serializable note" && !activity.snapshot().busy);
  assert.equal(activity.snapshot().phase, "detail");
  activity.dispatch(action(activity.snapshot(), "Edit note"));
  activity.dispatch(field(activity.snapshot(), "body", "Edited through the same journey"));
  activity.dispatch(action(activity.snapshot(), "Create note"));
  await until(() => activity.snapshot().phase === "review" && !activity.snapshot().busy);
  activity.dispatch(action(activity.snapshot(), "Edit note"));
  await until(() => activity.snapshot().phase === "detail" && !activity.snapshot().busy);
  const records = await session.read((await session.begin("read-note")).id);
  assert.equal(records.length, 1);
  assert.equal(records[0]?.facts.body, "Edited through the same journey");
  for (const snapshot of observed) {
    assert.deepEqual(activitySnapshot(roundtrip(snapshot)), snapshot);
    for (const key of ["state", "program", "prepared", "session", "token", "draft", "editing", "offers"]) {
      assert.equal(Object.hasOwn(snapshot, key), false, key);
    }
    assert.equal(JSON.stringify(snapshot).includes(identity.token), false);
  }
});

test("activity requests reject old revisions, foreign handles, forged fields, unavailable actions and terminal instances", async t => {
  const host = await openLocalController(application, { ...await cluster.database(), role: "notes" });
  t.after(() => host.close());
  const identity = await host.identities.issue("Activity ownership"), session = host.connect(identity.token, "human");
  const activity = localActivity(session, multiProgram, expected), foreign = localActivity(session, multiProgram, expected);
  t.after(() => { activity.stop(); foreign.stop(); });
  await Promise.all([activity.start(), foreign.start()]);
  await until(() => activity.snapshot().main.actions[0]?.state === "ready" && foreign.snapshot().main.actions[0]?.state === "ready");
  const home = action(activity.snapshot(), "Notes");
  assert.throws(() => foreign.dispatch({ ...home, revision: foreign.snapshot().revision }), /INVALID_ACTIVITY_HANDLE/);
  activity.dispatch(home);
  assert.throws(() => activity.dispatch(home), /STALE_ACTIVITY_REVISION/);
  assert.throws(() => activity.dispatch({ ...home, revision: activity.snapshot().revision }), /INVALID_ACTIVITY_HANDLE/);
  await until(() => activity.snapshot().main.actions.find(item => item.label === "New note")?.state === "ready");
  activity.dispatch(action(activity.snapshot(), "New note"));
  assert.throws(() => activity.dispatch(action(activity.snapshot(), "Create note")), /ACTIVITY_ACTION_UNAVAILABLE/);
  const edit = field(activity.snapshot(), "title", "One title");
  for (const bad of [{ ...edit, name: "owner" }, { ...edit, commandId: "arbitrary" }, { ...edit, value: 1 },
    { ...edit, version: "foreign" }, { ...edit, extra: true }]) {
    assert.throws(() => activity.dispatch(bad), /INVALID_ACTIVITY_REQUEST/);
  }
  let invoked = false;
  assert.throws(() => activity.dispatch({ ...edit, get value() { invoked = true; return "forged"; } }), /JSON|ACTIVITY/);
  assert.equal(invoked, false);
  activity.dispatch(edit);
  assert.throws(() => activity.dispatch(edit), /STALE_ACTIVITY_REVISION/);
  const afterEdit = field(activity.snapshot(), "body", "Retained");
  activity.stop();
  assert.throws(() => activity.dispatch(afterEdit), /ACTIVITY_STOPPED/);
  await activity.start();
  assert.throws(() => activity.dispatch(afterEdit), /ACTIVITY_STOPPED/);
  assert.deepEqual(await session.read((await session.begin("read-note")).id), []);
});

test("activity is bound to a genuine existing human exposure and its schemas are closed", async t => {
  assert.throws(() => localActivity({} as LocalSession, multiProgram, expected), /UNTRUSTED_LOCAL_SESSION/);
  const host = await openLocalController(application, { ...await cluster.database(), role: "notes" });
  t.after(() => host.close());
  const identity = await host.identities.issue("Activity admission");
  assert.throws(() => localActivity(host.connect(identity.token, "agent"), multiProgram, { ...expected, id: "agent" }), /INVALID_VIEW_PROGRAM_SURFACE/);
  assert.throws(() => activityRequest({ version: ActivityVersion, revision: 0, owner: "o", action: "a", state: {} }), /INVALID_ACTIVITY_REQUEST/);
  const activity = localActivity(host.connect(identity.token, "human"), multiProgram, expected);
  t.after(() => activity.stop());
  assert.throws(() => activitySnapshot({ ...activity.snapshot(), credentials: "no" }), /INVALID_ACTIVITY_SNAPSHOT/);
});
